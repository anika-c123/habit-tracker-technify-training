# Copy this file to .env.local and fill in the real values.
# Find them in the Supabase dashboard: Project Settings → API Keys.
# Both are safe to expose to the browser; never add the secret / service_role key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
